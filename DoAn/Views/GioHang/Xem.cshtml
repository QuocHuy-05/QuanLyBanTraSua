@model List<DACK_LTW_Nhom4.Models.GioHangItem>
@{
    ViewBag.Title = "Gio hang";
    decimal tamTinh = Model != null ? Model.Sum(x => x.ThanhTien) : 0;
    decimal soTienGiam = (decimal)ViewBag.SoTienGiamVoucher;
    string maVoucher = (string)ViewBag.MaVoucher;
    decimal tongThanhToan = tamTinh - soTienGiam;
    if (tongThanhToan < 0)
    {
        tongThanhToan = 0;
    }
}

<div class="container mt-4">
    <h2 class="section-title">Gio hang cua ban</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Gio hang dang trong. @Html.ActionLink("Xem menu", "Index", "Menu", null, new { @class = "alert-link" })
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="bg-white rounded p-3" style="border:1px solid #EEE5D8;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>San pham</th>
                                <th class="text-center" style="width:130px;">So luong</th>
                                <th class="text-right" style="width:120px;">Thanh tien</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                <tr data-index="@i">
                                    <td>
                                        <div style="font-weight:600;">@item.TenSanPham</div>
                                        <small class="text-muted">
                                            Size @item.Size &middot; Duong @item.MucDuong &middot; @item.MucDa
                                            @if (!string.IsNullOrEmpty(item.DanhSachTopping))
                                            {
                                                <br />
                                                <span>Topping: @item.DanhSachTopping</span>
                                            }
                                        </small>
                                        <div class="small text-muted mt-1">@string.Format("{0:N0}", item.DonGia + item.GiaTopping) d / cai</div>
                                    </td>
                                    <td class="text-center">
                                        <input type="number" class="form-control form-control-sm so-luong text-center mx-auto"
                                               style="width:80px;" min="1" max="20" value="@item.SoLuong" data-index="@i" />
                                    </td>
                                    <td class="text-right font-weight-bold thanh-tien" data-index="@i">
                                        @string.Format("{0:N0}", item.ThanhTien) d
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-link text-danger btn-xoa" data-index="@i" title="Xoa">&times;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-end">
                        <form method="post" action="@Url.Action("XoaToan", "GioHang")">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Xoa toan bo gio hang?');">
                                Xoa toan bo
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-white rounded p-3" style="border:1px solid #EEE5D8;">
                    <h5 class="mb-3" style="color:#4A2E14; font-weight:700;">Tom tat don hang</h5>

                    <!-- Voucher -->
                    <div class="form-group">
                        <label class="font-weight-bold">Ma voucher</label>
                        <div class="input-group">
                            <input type="text" id="maVoucherInput" class="form-control" placeholder="Nhap ma..." value="@maVoucher" />
                            <div class="input-group-append">
                                <button class="btn btn-trasua" id="btnApVoucher" type="button">Ap dung</button>
                            </div>
                        </div>
                        <div id="thongBaoVoucher" class="small mt-1"></div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between">
                        <span>Tam tinh:</span>
                        <span id="tamTinhDisplay" class="font-weight-bold">@string.Format("{0:N0}", tamTinh) d</span>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Giam voucher:</span>
                        <span id="giamGiaDisplay" class="text-danger">- @string.Format("{0:N0}", soTienGiam) d</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between" style="font-size:1.2rem;">
                        <strong>Tong cong:</strong>
                        <strong id="tongCongDisplay" style="color:#8B5A2B;">@string.Format("{0:N0}", tongThanhToan) d</strong>
                    </div>

                    <div class="mt-3">
                        @Html.ActionLink("Tien hanh dat hang", "XacNhan", "Checkout", null, new { @class = "btn btn-trasua btn-block btn-lg" })
                        @Html.ActionLink("Tiep tuc mua hang", "Index", "Menu", null, new { @class = "btn btn-outline-secondary btn-block" })
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        $(function () {
            // Cap nhat so luong
            $('.so-luong').on('change', function () {
                var index = $(this).data('index');
                var soLuong = parseInt($(this).val()) || 1;
                if (soLuong < 1) soLuong = 1;
                if (soLuong > 20) soLuong = 20;
                $(this).val(soLuong);

                $.post('@Url.Action("CapNhat", "GioHang")', { index: index, soLuong: soLuong }, function (rs) {
                    if (rs.thanhCong) {
                        $('.thanh-tien[data-index="' + index + '"]').text(formatTien(rs.thanhTien));
                        $('#tamTinhDisplay').text(formatTien(rs.tamTinh));
                        $('#giamGiaDisplay').text('- 0 d');
                        $('#tongCongDisplay').text(formatTien(rs.tamTinh));
                        $('#thongBaoVoucher').html('<span class="text-warning">Voucher da bo do thay doi gio hang. Ap lai neu can.</span>');
                    }
                });
            });

            // Xoa 1 dong
            $('.btn-xoa').on('click', function () {
                if (!confirm('Xoa san pham nay khoi gio?')) return;
                var index = $(this).data('index');
                $.post('@Url.Action("Xoa", "GioHang")', { index: index }, function (rs) {
                    if (rs.thanhCong) {
                        location.reload();
                    }
                });
            });

            // Ap voucher
            $('#btnApVoucher').on('click', function () {
                var ma = $('#maVoucherInput').val().trim();
                if (!ma) {
                    $('#thongBaoVoucher').html('<span class="text-danger">Vui long nhap ma voucher.</span>');
                    return;
                }
                $.post('@Url.Action("ApVoucher", "GioHang")', { maCode: ma }, function (rs) {
                    if (rs.thanhCong) {
                        $('#giamGiaDisplay').text('- ' + formatTien(rs.soTienGiam));
                        $('#tongCongDisplay').text(formatTien(rs.tongSauGiam));
                        $('#thongBaoVoucher').html('<span class="text-success">' + rs.thongBao + '</span>');
                    } else {
                        $('#thongBaoVoucher').html('<span class="text-danger">' + rs.thongBao + '</span>');
                    }
                });
            });

            function formatTien(n) {
                return Math.round(n).toLocaleString('vi-VN') + ' d';
            }
        });
    </script>
}
