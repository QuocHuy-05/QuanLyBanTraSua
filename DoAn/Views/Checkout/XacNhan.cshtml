@model DACK_LTW_Nhom4.ViewModels.CheckoutVM
@{
    ViewBag.Title = "Xac nhan don hang";
    var gio = ViewBag.GioHang as System.Collections.Generic.List<DACK_LTW_Nhom4.Models.GioHangItem>;
    decimal tamTinh = (decimal)ViewBag.TamTinh;
    decimal soTienGiam = (decimal)ViewBag.SoTienGiam;
    decimal tongCong = (decimal)ViewBag.TongCong;
    string maVoucher = (string)ViewBag.MaVoucher;
}

<div class="container mt-4">
    <h2 class="section-title">Xac nhan don hang</h2>

    <form method="post" action="@Url.Action("DatHang", "Checkout")">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row">
            <div class="col-lg-7">
                <div class="bg-white rounded p-4" style="border:1px solid #EEE5D8;">
                    <h5 class="mb-3" style="color:#4A2E14; font-weight:700;">Thong tin giao hang</h5>

                    <div class="form-group">
                        @Html.LabelFor(m => m.TenNguoiNhan)
                        @Html.TextBoxFor(m => m.TenNguoiNhan, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.TenNguoiNhan, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.SoDienThoai)
                        @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.DiaChiGiaoHang)
                        @Html.TextAreaFor(m => m.DiaChiGiaoHang, new { @class = "form-control", rows = "2" })
                        @Html.ValidationMessageFor(m => m.DiaChiGiaoHang, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.GhiChu)
                        @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = "2", placeholder = "(Tuy chon)" })
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="bg-white rounded p-4" style="border:1px solid #EEE5D8;">
                    <h5 class="mb-3" style="color:#4A2E14; font-weight:700;">Tom tat don hang</h5>

                    @if (gio != null)
                    {
                        foreach (var item in gio)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <div class="small">
                                    <div>@item.TenSanPham <span class="text-muted">x@item.SoLuong</span></div>
                                    <div class="text-muted">Size @item.Size &middot; @item.MucDuong &middot; @item.MucDa</div>
                                </div>
                                <div class="text-right small font-weight-bold">@string.Format("{0:N0}", item.ThanhTien) d</div>
                            </div>
                        }
                    }

                    <hr />
                    <div class="d-flex justify-content-between">
                        <span>Tam tinh:</span>
                        <span>@string.Format("{0:N0}", tamTinh) d</span>
                    </div>
                    @if (soTienGiam > 0)
                    {
                        <div class="d-flex justify-content-between mt-2">
                            <span>Voucher (@maVoucher):</span>
                            <span class="text-danger">- @string.Format("{0:N0}", soTienGiam) d</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between" style="font-size:1.25rem;">
                        <strong>Tong cong:</strong>
                        <strong style="color:#8B5A2B;">@string.Format("{0:N0}", tongCong) d</strong>
                    </div>

                    <button type="submit" class="btn btn-trasua btn-block btn-lg mt-3">Xac nhan dat hang</button>
                    @Html.ActionLink("Quay lai gio hang", "Xem", "GioHang", null, new { @class = "btn btn-outline-secondary btn-block" })
                </div>
            </div>
        </div>
    </form>
</div>
