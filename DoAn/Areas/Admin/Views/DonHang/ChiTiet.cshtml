@model DACK_LTW_Nhom4.Models.DonHang
@{
    ViewBag.Title = "Don #" + Model.MaDonHang;
}

<div class="bg-white rounded p-4 mb-3" style="border:1px solid #E5D8C5;">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h5 style="color:#4A2E14; font-weight:700;" class="mb-0">Don hang #@Model.MaDonHang</h5>
        <span class="badge-trangthai badge-@Model.TrangThai">@Model.TrangThai</span>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <h6>Khach hang</h6>
            <p class="mb-1">@(Model.NguoiDung != null ? Model.NguoiDung.HoTen : "") (@(Model.NguoiDung != null ? Model.NguoiDung.Email : ""))</p>
            <p class="mb-1"><strong>Nguoi nhan:</strong> @Model.TenNguoiNhan</p>
            <p class="mb-1"><strong>SDT:</strong> @Model.SoDienThoai</p>
            <p class="mb-1"><strong>Dia chi:</strong> @Model.DiaChiGiaoHang</p>
            @if (!string.IsNullOrEmpty(Model.GhiChu))
            {
                <p class="mb-1"><strong>Ghi chu:</strong> @Model.GhiChu</p>
            }
        </div>
        <div class="col-md-6">
            <h6>Thoi gian</h6>
            <p class="mb-1"><strong>Dat luc:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="mb-1"><strong>Cap nhat:</strong> @Model.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</p>
            @if (!string.IsNullOrEmpty(Model.MaVoucherDaDung))
            {
                <p class="mb-1"><strong>Voucher:</strong> @Model.MaVoucherDaDung</p>
            }
            @if (Model.TrangThai == "DaHuy" && !string.IsNullOrEmpty(Model.LyDoHuy))
            {
                <p class="mb-1 text-danger"><strong>Ly do huy:</strong> @Model.LyDoHuy</p>
            }
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>San pham</th>
                <th class="text-center">SL</th>
                <th class="text-right">Don gia</th>
                <th class="text-right">Thanh tien</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model.ChiTietDonHang)
            {
                <tr>
                    <td>
                        <div style="font-weight:600;">@ct.TenSanPham</div>
                        <small class="text-muted">
                            Size @ct.Size &middot; @ct.MucDuong &middot; @ct.MucDa
                            @if (!string.IsNullOrEmpty(ct.DanhSachTopping)) { <br /><span>Topping: @ct.DanhSachTopping</span> }
                        </small>
                    </td>
                    <td class="text-center">@ct.SoLuong</td>
                    <td class="text-right">@string.Format("{0:N0}", ct.DonGia + ct.GiaTopping) d</td>
                    <td class="text-right font-weight-bold">@string.Format("{0:N0}", ct.ThanhTien) d</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right">Tam tinh:</td>
                <td class="text-right">@string.Format("{0:N0}", Model.TamTinh) d</td>
            </tr>
            @if (Model.GiamVoucher > 0)
            {
                <tr>
                    <td colspan="3" class="text-right">Giam voucher:</td>
                    <td class="text-right text-danger">- @string.Format("{0:N0}", Model.GiamVoucher) d</td>
                </tr>
            }
            <tr>
                <td colspan="3" class="text-right" style="font-size:1.15rem;"><strong>Tong:</strong></td>
                <td class="text-right" style="font-size:1.15rem; color:#8B5A2B;"><strong>@string.Format("{0:N0}", Model.TongThanhToan) d</strong></td>
            </tr>
        </tfoot>
    </table>
</div>

@if (Model.TrangThai != "DaHuy" && Model.TrangThai != "HoanThanh")
{
    <div class="bg-white rounded p-4 mb-3" style="border:1px solid #E5D8C5;">
        <h6>Chuyen trang thai</h6>
        <div class="d-flex flex-wrap">
            <button class="btn btn-info mr-2 mb-2 btn-doi-tt" data-tt="ChoXacNhan">Cho xac nhan</button>
            <button class="btn btn-info mr-2 mb-2 btn-doi-tt" data-tt="DangChuanBi">Dang chuan bi</button>
            <button class="btn btn-primary mr-2 mb-2 btn-doi-tt" data-tt="DangGiao">Dang giao</button>
            <button class="btn btn-success mr-2 mb-2 btn-doi-tt" data-tt="HoanThanh">Hoan thanh</button>
        </div>
    </div>

    <div class="bg-white rounded p-4" style="border:1px solid #E5D8C5;">
        <h6 class="text-danger">Huy don</h6>
        <form method="post" action="@Url.Action("Huy", "DonHang", new { area = "Admin" })" onsubmit="return confirm('Xac nhan huy don nay?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaDonHang" />
            <div class="form-group">
                <input type="text" name="lyDo" class="form-control" placeholder="Ly do huy (bat buoc)" required />
            </div>
            <button type="submit" class="btn btn-outline-danger">Huy don hang</button>
        </form>
    </div>
}

<div class="mt-3">
    @Html.ActionLink("Quay lai danh sach", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

@section scripts {
    <script>
        $(function () {
            $('.btn-doi-tt').on('click', function () {
                var tt = $(this).data('tt');
                if (!confirm('Chuyen trang thai sang "' + tt + '"?')) return;
                $.post('@Url.Action("DoiTrangThai")', { id: @Model.MaDonHang, trangThai: tt }, function (rs) {
                    if (rs.thanhCong) location.reload();
                    else alert(rs.thongBao || 'Co loi.');
                });
            });
        });
    </script>
}
